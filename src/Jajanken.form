                  <Font name="Bookman Old Style" size="12" style="0"/>
                </Property>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="No universo de Hunter &#xd7; Hunter, &#xa;cada batalha depende de estrat&#xe9;gia, &#xa;intelig&#xea;ncia e coragem. &#xa;Neste desafio de Pedra, Papel e Tesoura, &#xa;voc&#xea; dever&#xe1; prever o movimento&#xa; do seu oponente como um verdadeiro&#xa; Hunter!&#xa;Pedra derrota Tesoura com sua for&#xe7;a, &#xa;Tesoura corta Papel com velocidade&#xa; e precis&#xe3;o, e Papel vence Pedra usando &#xa;estrat&#xe9;gia e controle.&#xa;Escolha sabiamente e mostre suas&#xa; habilidades no combate!"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
